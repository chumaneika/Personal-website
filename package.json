{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "workspaces": [
    "frontend-public",
    "frontend-admin"
  ],
  "scripts": {
    "dev:public": "npm run dev --workspace @personal-website/frontend-public",
    "dev:admin": "npm run dev --workspace @personal-website/frontend-admin",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces && eslint e2e playwright.config.ts --max-warnings=0",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "prettier --write \"frontend-public/src/**/*.{ts,tsx,scss}\" \"frontend-admin/src/**/*.{ts,tsx,scss}\" \"frontend-public/*.{ts,json}\" \"frontend-admin/*.{ts,json}\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"ops/frontend/*.mjs\" \"docs/**/*.md\" \"*.{js,json,md}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"frontend-public/src/**/*.{ts,tsx,scss}\" \"frontend-admin/src/**/*.{ts,tsx,scss}\" \"frontend-public/*.{ts,json}\" \"frontend-admin/*.{ts,json}\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"ops/frontend/*.mjs\" \"docs/**/*.md\" \"*.{js,json,md}\" \".github/**/*.{yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "build:public": "npm run build:production --workspace @personal-website/frontend-public && npm run verify:build:public",
    "build:admin": "npm run build:production --workspace @personal-website/frontend-admin && npm run verify:build:admin",
    "build": "npm run build:public && npm run build:admin",
    "verify:build:public": "node ops/frontend/verify-build.mjs frontend-public",
    "verify:build:admin": "node ops/frontend/verify-build.mjs frontend-admin",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "preview:public": "npm run preview --workspace @personal-website/frontend-public",
    "preview:admin": "npm run preview --workspace @personal-website/frontend-admin"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
