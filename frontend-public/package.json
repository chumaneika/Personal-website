{
  "name": "@personal-website/frontend-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "typegen": "react-router typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "build": "npm run build:production",
    "build:production": "npm run typecheck && react-router build",
    "start": "react-router-serve build/server/index.js",
    "preview": "npm run start"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@sentry/react": "^10.75.0",
    "axios": "^1.20.0",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.4.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sass": "^1.104.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.6"
  }
}
