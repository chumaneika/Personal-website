# Copy this file to .env and adjust the non-secret deployment settings.
# Never commit .env. Secret values belong in files outside this repository.

# Immutable tag shared by all application images in one release. Keep older
# tags available so application-only rollback does not require a rebuild.
RELEASE_VERSION=2026.07.28-1

# REQUIRED for Docker Compose: absolute path to an external directory containing
# APP_ADMIN_PASSWORD, APP_ADMIN_RECOVERY_PASSWORD, SPRING_DATASOURCE_PASSWORD,
# and SPRING_MAIL_PASSWORD. Protect the directory with mode 700 and files with 600.
APP_SECRETS_DIRECTORY=/absolute/path/outside/the/repository/personal-website-secrets

# One-time initial administrator bootstrap. Leave disabled during normal starts.
# To bootstrap a fresh database, enable it for exactly one start and put a
# 12-128 character password with at least one letter and one number in the
# external APP_ADMIN_PASSWORD file. Disable it and empty that file immediately.
APP_ADMIN_INITIALIZER_ENABLED=false
APP_ADMIN_EMAIL=

# One-time emergency password recovery. Keep disabled during normal operation.
# Put the new password in the external APP_ADMIN_RECOVERY_PASSWORD file only for
# one startup, then disable recovery and empty that file again.
APP_ADMIN_RECOVERY_ENABLED=false
APP_ADMIN_RECOVERY_EMAIL=

# Exact production origins only. Use localhost origins only in a developer-specific
# ignored .env when running Vite outside Docker.
APP_CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com
APP_SESSION_TIMEOUT=30m
APP_SESSION_COOKIE_SECURE=true
APP_SESSION_COOKIE_SAME_SITE=strict
APP_SECURITY_REQUIRE_HTTPS=true
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_ATTEMPT_WINDOW=15m
APP_LOGIN_BLOCK_DURATION=15m

# Public contact form abuse protection and retention.
APP_CONTACT_MAX_REQUEST_BYTES=16384
APP_CONTACT_DUPLICATE_WINDOW=24h
APP_CONTACT_RATE_LIMIT_MAX_SUBMISSIONS=5
APP_CONTACT_RATE_LIMIT_WINDOW=10m
APP_CONTACT_RETENTION_ENABLED=true
APP_CONTACT_RETENTION_CRON=0 30 3 * * *
APP_CONTACT_ARCHIVE_READ_AFTER=30d
APP_CONTACT_DELETE_ARCHIVED_AFTER=365d

# Optional email notification for accepted messages.
APP_CONTACT_EMAIL_NOTIFICATIONS_ENABLED=false
APP_CONTACT_EMAIL_FROM=
APP_CONTACT_EMAIL_TO=
APP_CONTACT_EMAIL_SUBJECT=New contact form message

# SPRING_MAIL_PASSWORD is read from APP_SECRETS_DIRECTORY. Its file may remain empty
# while notifications are disabled.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_CHECKSERVERIDENTITY=true

# Host-run Spring datasource. Its password is read from the external
# SPRING_DATASOURCE_PASSWORD file.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/users_db
SPRING_DATASOURCE_USERNAME=postgres-user
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Docker Compose PostgreSQL settings. PostgreSQL has no published host port and
# is reachable only by backend and backup containers on an internal network.
# The database uses the same external SPRING_DATASOURCE_PASSWORD file.
POSTGRES_DB=users_db
POSTGRES_USER=postgres-user

# Automatic pg_dump backups. The directory is local and ignored by Git.
POSTGRES_BACKUP_DIRECTORY=./backups/postgres
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_RETRY_SECONDS=300
POSTGRES_BACKUP_RETENTION_DAYS=14

# Public DNS names must point to this server before Caddy requests certificates.
# Only the edge proxy publishes ports; frontend, backend, and database services
# remain reachable exclusively through Docker networks.
PUBLIC_DOMAIN=www.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=admin@example.com
REVERSE_PROXY_BIND_ADDRESS=0.0.0.0
REVERSE_PROXY_HTTP_PORT=80
REVERSE_PROXY_HTTPS_PORT=443

# Non-secret API URLs embedded into the browser bundles at image build time.
# Keep /api for the recommended same-origin Nginx proxy deployment.
PUBLIC_FRONTEND_API_URL=/api
ADMIN_FRONTEND_API_URL=/api

# Used only when Spring Boot runs directly on the host.
APP_SERVER_ADDRESS=127.0.0.1

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# Keep false for fresh databases. Set true only for the one-time adoption of a
# pre-Flyway schema, then immediately return it to false.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false

# The Compose deployment terminates HTTPS at Caddy and always uses the hardened profile.
SPRING_PROFILES_ACTIVE=prod
