global:
  scrape_interval: 15s
  scrape_timeout: 10s
  evaluation_interval: 15s
  external_labels:
    environment: "__OBSERVABILITY_ENVIRONMENT__"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:9090

  - job_name: backend
    metrics_path: /actuator/prometheus
    static_configs:
      - targets:
          - backend:8080
        labels:
          service: backend

  - job_name: backend-health
    metrics_path: /probe
    params:
      module:
        - http_2xx
    static_configs:
      - targets:
          - http://backend:8080/actuator/health/liveness
        labels:
          service: backend
          check: liveness
      - targets:
          - http://backend:8080/actuator/health/readiness
        labels:
          service: backend
          check: readiness
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-sites
    metrics_path: /probe
    params:
      module:
        - http_2xx
    static_configs:
      - targets:
          - __PUBLIC_SITE_PROBE_URL__
        labels:
          service: frontend-public
          site: public
      - targets:
          - __ADMIN_SITE_PROBE_URL__
        labels:
          service: frontend-admin
          site: admin
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: alertmanager
    static_configs:
      - targets:
          - alertmanager:9093

  - job_name: blackbox-exporter
    static_configs:
      - targets:
          - blackbox-exporter:9115

  - job_name: loki
    static_configs:
      - targets:
          - loki:3100

  - job_name: alloy
    static_configs:
      - targets:
          - alloy:12345

  - job_name: grafana
    static_configs:
      - targets:
          - grafana:3000
